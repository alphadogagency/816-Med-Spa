---
const year = new Date().getFullYear();

const links = [
  { href: "/", label: "Home" },
  { href: "/treatments", label: "Treatments" },
  { href: "/memberships", label: "Memberships" },
  { href: "/locations", label: "Areas We Serve" },
  { href: "/#about", label: "About Us" },
  { href: "/contact-us", label: "Book Appointment" },
  { href: "/contact-us", label: "Contact Us" },
];
---

<footer class="border-t border-sage/20 bg-white py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
      <a href="/" aria-label="816 Med Spa home">
        <img src="/logo.png" alt="816 Med Spa" class="h-12 w-auto" />
      </a>
      <nav class="flex flex-wrap justify-center gap-6 text-sm text-gray-600" aria-label="Footer">
        {links.map((link) => (
          <a href={link.href} class="transition hover:text-sage">{link.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-3" role="group" aria-label="Social media">
        <a
          href="https://www.facebook.com/p/816-Aesthetic-Medical-Spa-61564981695970/"
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-10 place-items-center rounded-full border border-sage/25 bg-bone text-sage transition hover:border-sage hover:bg-sage hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          aria-label="Visit 816 Aesthetic Medical Spa on Facebook"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M16 8.049C16 3.603 12.418 0 8 0S0 3.603 0 8.049C0 12.067 2.925 15.397 6.75 16v-5.624H4.719V8.049H6.75V6.276c0-2.017 1.194-3.131 3.022-3.131.875 0 1.791.157 1.791.157v1.984h-1.009c-.994 0-1.304.621-1.304 1.258v1.505h2.219l-.355 2.327H9.25V16C13.075 15.397 16 12.067 16 8.049Z"></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/816aestheticmedspa/"
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-10 place-items-center rounded-full border border-sage/25 bg-bone text-sage transition hover:border-sage hover:bg-sage hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          aria-label="Visit 816 Aesthetic Medical Spa on Instagram"
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@816.medspa.kc?_r=1&_t=ZT-98T3fnf4m57"
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-10 place-items-center rounded-full border border-sage/25 bg-bone text-sage transition hover:border-sage hover:bg-sage hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          aria-label="Visit 816 Aesthetic Medical Spa on TikTok"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.72-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.45 3.99-2.14 6.15-1.74.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.11-.01 2.17-.66 2.75-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 border-t border-sage/15 pt-6 text-center text-sm text-gray-600 sm:flex-row sm:gap-6">
      <p>&copy; {year} 816 Aesthetic Med Spa. All rights reserved.</p>
      <a
        href="/privacy-policy/"
        class="underline underline-offset-4 transition hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sage"
      >Privacy Policy</a>
    </div>
  </div>
</footer>
